# No hace falta copiarlo: arrancar.bat crea el .env con una clave nueva.
# Si creas el .env a mano a partir de este archivo, cambia APP_PASSWORD y AUTH_SECRET.
# El archivo .env NO se sube a Git.

# Contraseña para entrar en la app (pon una larga: al menos 8 caracteres)
APP_PASSWORD=cambia-esta-contraseña

# Clave para firmar la sesión: una cadena larga y aleatoria.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Base de datos.
# - Con Docker (docker compose up) no hace falta: la pone docker-compose.yml.
# - Para "npm run dev" en tu PC con la base de datos de Docker:
DATABASE_URL=postgres://vapers:vapers@localhost:5433/vapers
# - Con Supabase: Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543)
# DATABASE_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Solo para migraciones contra Supabase: la conexión "Session pooler" (puerto 5432)
# DATABASE_URL_MIGRATIONS=postgresql://postgres.xxxx:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Zona horaria de la tienda (para "ventas de hoy")
APP_TZ=Europe/Madrid

# Cabecera de la que se lee la IP del visitante (límite de reservas y de contraseñas fallidas).
# Sin ponerla: x-real-ip en Vercel y x-forwarded-for en los demás casos.
# Con el catálogo publicado por un túnel de Cloudflare:
# CABECERA_IP=cf-connecting-ip
